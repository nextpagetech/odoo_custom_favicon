<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the mail_plugin.app_auth template -->
    <template id="mail_plugin_app_auth_inherit" inherit_id="mail_plugin.app_auth">
        <!-- Replace the paragraph that contains the Odoo text -->
        <xpath expr="//p[contains(., 'Odoo database?')]" position="replace">
            <p class="text-center">
                Let <t t-esc="friendlyname" /> access your Custom ERP database?
            </p>
        </xpath>
    </template>
</odoo>
