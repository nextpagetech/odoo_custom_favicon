<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tree view -->
    <record id="view_orderpoint_tree_custom" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.custom</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <list string="Reordering Rules" create="true">
                <field name="product_id" />
                <field name="location_id"/>
                <field name="product_min_qty" />
                <field name="product_max_qty" />
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_orderpoint_form_custom" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form.custom</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="arch" type="xml">
            <form string="Reordering Rule">
                <sheet>
                    <group>
                        <field name="product_id" />
                        <field name="location_id" />
                        <field name="product_min_qty" />
                        <field name="product_max_qty" />
                    </group>  
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_reordering_rules_custom" model="ir.actions.act_window">
        <field name="name">Reordering Rules</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_orderpoint_tree_custom" />
        <field name="domain">['|', ('product_min_qty', '&gt;', 0), ('product_max_qty', '&gt;', 0)]</field>
        <field name="views" eval="[(ref('view_orderpoint_tree_custom'),'list'), (ref('view_orderpoint_form_custom'),'form')]"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_reordering_rules_custom"
        name="Reordering Rules"
        parent="stock.menu_warehouse_report"
        action="action_reordering_rules_custom"
        sequence="30" />

</odoo>
