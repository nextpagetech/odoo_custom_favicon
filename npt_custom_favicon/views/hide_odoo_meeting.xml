<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Hide in Main Form View -->
    <record id="calendar_event_form_hide_odoo_meeting" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.hide.odoo.meeting</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='set_discuss_videocall_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- 2. Hide in Quick Create View -->
    <record id="calendar_event_form_quick_create_hide_odoo_meeting" model="ir.ui.view">
        <field name="name">calendar.event.form.quick_create.inherit.hide.odoo.meeting</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='set_discuss_videocall_location']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
